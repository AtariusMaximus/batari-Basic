   1934  afc9				  -	      rol
   1935  afc9				  -	      rol
   1936  afc9				  -	      rol
   1937  afc9				  -	      rol
   1938  afc9				  -	      and	#bs_mask	;1 3 or 7 for F8/F6/F4
   1939  afc9				  -	      tax
   1940  afc9				  -	      inx
   1941  afc9					      else
   1942  afc9		       b5 04		      lda	4,x	; get high byte of return address
   1943  afcb		       a8		      tay
   1944  afcc		       09 10		      ora	#$10	; change our bank nibble into a valid rom mirror
   1945  afce		       95 04		      sta	4,x
   1946  afd0		       98		      tya
   1947  afd1		       4a		      lsr
   1948  afd2		       4a		      lsr
   1949  afd3		       4a		      lsr
   1950  afd4		       4a		      lsr
   1951  afd5		       aa		      tax
   1952  afd6		       e8		      inx
   1953  afd7					      endif
   1954  afd7		       bd df 1f 	      lda	bankswitch_hotspot-1,x
   1955  afda		       68		      pla
   1956  afdb		       aa		      tax
   1957  afdc		       68		      pla
   1958  afdd		       60		      rts
   1959  afde				  -	      if	((* & $1FFF) > ((bankswitch_hotspot & $1FFF) - 1))
   1960  afde				  -	      echo	"WARNING: size parameter in banksw.asm too small - the program probably will not work."
   1961  afde				  -	      echo	"Change to",[(*-begin_bscode+1)&$FF]d,"and try again."
   1962  afde					      endif
