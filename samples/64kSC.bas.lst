   4653  10fbc							; every bank has this stuff at the same place
   4654  10fbc							; this code can switch to/from any bank at any entry point
   4655  10fbc							; and can preserve register values
   4656  10fbc							; note: lines not starting with a space are not placed in all banks
   4657  10fbc							;
   4658  10fbc							; line below tells the compiler how long this is - do not remove
   4659  10fbc							;size=32
   4660  10fbc
   4661  10fbc				    begin_bscode
   4662  10fbc			a2 ff		       ldx	#$ff
   4663  10fbe				   -	       ifconst	FASTFETCH	; using DPC+
   4664  10fbe				   -	       stx	FASTFETCH
   4665  10fbe					       endif
   4666  10fbe			9a		       txs
   4667  10fbf					       if	bankswitch == 64
   4668  10fbf			a9 f3		       lda	#(((>(start-1)) & $0F) | $F0)
   4669  10fc1				   -	       else
   4670  10fc1				   -	       lda	#>(start-1)
   4671  10fc1					       endif
   4672  10fc1			48		       pha
   4673  10fc2			a9 4f		       lda	#<(start-1)
   4674  10fc4			48		       pha
   4675  10fc5
   4676  10fc5				    BS_return
   4677  10fc5			48		       pha
   4678  10fc6			8a		       txa
   4679  10fc7			48		       pha
   4680  10fc8			ba		       tsx
   4681  10fc9
   4682  10fc9				   -	       if	bankswitch != 64
   4683  10fc9				   -	       lda	4,x	; get high byte of return address
   4684  10fc9				   -
   4685  10fc9				   -	       rol
   4686  10fc9				   -	       rol
   4687  10fc9				   -	       rol
   4688  10fc9				   -	       rol
   4689  10fc9				   -	       and	#bs_mask	;1 3 or 7 for F8/F6/F4
   4690  10fc9				   -	       tax
   4691  10fc9				   -	       inx
   4692  10fc9					       else
   4693  10fc9			b5 04		       lda	4,x	; get high byte of return address
   4694  10fcb			a8		       tay
   4695  10fcc			09 10		       ora	#$10	; change our bank nibble into a valid rom mirror
   4696  10fce			95 04		       sta	4,x
   4697  10fd0			98		       tya
   4698  10fd1			4a		       lsr
   4699  10fd2			4a		       lsr
   4700  10fd3			4a		       lsr
   4701  10fd4			4a		       lsr
   4702  10fd5			aa		       tax
   4703  10fd6			e8		       inx
   4704  10fd7					       endif
