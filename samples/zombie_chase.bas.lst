     26  10000 ????
     27  10000 ????		00 e3	    timer1     =	p
     28  10000 ????
     29  10000 ????		00 e2	    scadd      =	o
     30  10000 ????
     31  10000 ????		00 e1	    last       =	n
     32  10000 ????
     33  10000 ????		00 85	    p0y        =	player0y
     34  10000 ????		00 80	    p0x        =	player0x
