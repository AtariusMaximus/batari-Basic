   2100  3100					      if	ECHO3
      3796 bytes of ROM space left in bank 3
   2101  3100					      echo	"    ",[(start_bank3 - *)]d , "bytes of ROM space left in bank 3")
   2102  3100					      endif
   2103  3100		       00 01	   ECHO3      =	1
   2104  3fd4					      ORG	$3FF4-bscode_length
   2105  3fd4					      RORG	$DFF4-bscode_length
   2106  3fd4		       a2 ff	   start_bank3 ldx	#$ff
   2107  3fd6				  -	      ifconst	FASTFETCH	; using DPC+
   2108  3fd6				  -	      stx	FASTFETCH
   2109  3fd6					      endif
   2110  3fd6		       9a		      txs
   2111  3fd7				  -	      if	bankswitch == 64
   2112  3fd7				  -	      lda	#(((>(start-1)) & $0F) | $F0)
   2113  3fd7					      else
   2114  3fd7		       a9 f3		      lda	#>(start-1)
   2115  3fd9					      endif
   2116  3fd9		       48		      pha
   2117  3fda		       a9 da		      lda	#<(start-1)
   2118  3fdc		       48		      pha
   2119  3fdd		       48		      pha
   2120  3fde		       8a		      txa
   2121  3fdf		       48		      pha
   2122  3fe0		       ba		      tsx
   2123  3fe1					      if	bankswitch != 64
   2124  3fe1		       b5 04		      lda	4,x	; get high byte of return address
   2125  3fe3		       2a		      rol
   2126  3fe4		       2a		      rol
   2127  3fe5		       2a		      rol
   2128  3fe6		       2a		      rol
   2129  3fe7		       29 03		      and	#bs_mask	;1 3 or 7 for F8/F6/F4
   2130  3fe9		       aa		      tax
   2131  3fea		       e8		      inx
   2132  3feb				  -	      else
   2133  3feb				  -	      lda	4,x	; get high byte of return address
   2134  3feb				  -	      tay
   2135  3feb				  -	      ora	#$10	; change our bank nibble into a valid rom mirror
   2136  3feb				  -	      sta	4,x
   2137  3feb				  -	      tya
   2138  3feb				  -	      lsr
   2139  3feb				  -	      lsr
   2140  3feb				  -	      lsr
