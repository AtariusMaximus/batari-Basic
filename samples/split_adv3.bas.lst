   4085  4fd4				   begin_bscode
   4086  4fd4		       a2 ff		      ldx	#$ff
   4087  4fd6				  -	      ifconst	FASTFETCH	; using DPC+
   4088  4fd6				  -	      stx	FASTFETCH
   4089  4fd6					      endif
   4090  4fd6		       9a		      txs
   4091  4fd7				  -	      if	bankswitch == 64
   4092  4fd7				  -	      lda	#(((>(start-1)) & $0F) | $F0)
   4093  4fd7					      else
   4094  4fd7		       a9 f3		      lda	#>(start-1)
   4095  4fd9					      endif
   4096  4fd9		       48		      pha
   4097  4fda		       a9 da		      lda	#<(start-1)
   4098  4fdc		       48		      pha
