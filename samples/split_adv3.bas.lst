     24  5000 ????	       00 df	   p2_player0pointerlo =	l
     25  5000 ????
     26  5000 ????	       00 de	   p2_player1x =	k
     27  5000 ????
     28  5000 ????	       00 dd	   p2_player1y =	j
     29  5000 ????
     30  5000 ????	       00 dc	   p1_oldy    =	i
     31  5000 ????
     32  5000 ????	       00 db	   p1_oldx    =	h
     33  5000 ????
     34  5000 ????	       00 da	   p0_oldy    =	g
