   1717  3100					      echo	"    ",[(start_bank3 - *)]d , "bytes of ROM space left in bank 3")
   1718  3100					      endif
   1719  3100		       00 01	   ECHO3      =	1
   1720  3fd4					      ORG	$3FF4-bscode_length
   1721  3fd4					      RORG	$DFF4-bscode_length
