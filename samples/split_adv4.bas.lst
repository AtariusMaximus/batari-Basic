   3701  4fd4				   begin_bscode
   3702  4fd4		       a2 ff		      ldx	#$ff
   3703  4fd6				  -	      ifconst	FASTFETCH	; using DPC+
   3704  4fd6				  -	      stx	FASTFETCH
   3705  4fd6					      endif
   3706  4fd6		       9a		      txs
   3707  4fd7				  -	      if	bankswitch == 64
   3708  4fd7				  -	      lda	#(((>(start-1)) & $0F) | $F0)
   3709  4fd7					      else
   3710  4fd7		       a9 f3		      lda	#>(start-1)
   3711  4fd9					      endif
   3712  4fd9		       48		      pha
   3713  4fda		       a9 da		      lda	#<(start-1)
   3714  4fdc		       48		      pha
