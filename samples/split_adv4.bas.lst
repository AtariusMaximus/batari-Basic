   1746  3fe9		       aa		      tax
   1747  3fea		       e8		      inx
   1748  3feb				  -	      else
   1749  3feb				  -	      lda	4,x	; get high byte of return address
   1750  3feb				  -	      tay
   1751  3feb				  -	      ora	#$10	; change our bank nibble into a valid rom mirror
   1752  3feb				  -	      sta	4,x
