   9405  4fd4							; this code can switch to/from any bank at any entry point
   9406  4fd4							; and can preserve register values
   9407  4fd4							; note: lines not starting with a space are not placed in all banks
   9408  4fd4							;
   9409  4fd4							; line below tells the compiler how long this is - do not remove
   9410  4fd4							;size=32
