   9414  4fd6				  -	      ifconst	FASTFETCH	; using DPC+
   9415  4fd6				  -	      stx	FASTFETCH
   9416  4fd6					      endif
   9417  4fd6		       9a		      txs
   9418  4fd7				  -	      if	bankswitch == 64
   9419  4fd7				  -	      lda	#(((>(start-1)) & $0F) | $F0)
   9420  4fd7					      else
