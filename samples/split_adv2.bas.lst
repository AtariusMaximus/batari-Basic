   4249  4fd4							; Provided under the CC0 license. See the included LICENSE.txt for details.
   4250  4fd4
   4251  4fd4							; every bank has this stuff at the same place
   4252  4fd4							; this code can switch to/from any bank at any entry point
   4253  4fd4							; and can preserve register values
   4254  4fd4							; note: lines not starting with a space are not placed in all banks
   4255  4fd4							;
   4256  4fd4							; line below tells the compiler how long this is - do not remove
   4257  4fd4							;size=32
   4258  4fd4
   4259  4fd4				   begin_bscode
   4260  4fd4		       a2 ff		      ldx	#$ff
   4261  4fd6				  -	      ifconst	FASTFETCH	; using DPC+
   4262  4fd6				  -	      stx	FASTFETCH
   4263  4fd6					      endif
   4264  4fd6		       9a		      txs
   4265  4fd7				  -	      if	bankswitch == 64
   4266  4fd7				  -	      lda	#(((>(start-1)) & $0F) | $F0)
   4267  4fd7					      else
   4268  4fd7		       a9 f3		      lda	#>(start-1)
   4269  4fd9					      endif
   4270  4fd9		       48		      pha
   4271  4fda		       a9 d4		      lda	#<(start-1)
   4272  4fdc		       48		      pha
   4273  4fdd
   4274  4fdd				   BS_return
   4275  4fdd		       48		      pha
   4276  4fde		       8a		      txa
   4277  4fdf		       48		      pha
   4278  4fe0		       ba		      tsx
   4279  4fe1
   4280  4fe1					      if	bankswitch != 64
   4281  4fe1		       b5 04		      lda	4,x	; get high byte of return address
   4282  4fe3
   4283  4fe3		       2a		      rol
   4284  4fe4		       2a		      rol
   4285  4fe5		       2a		      rol
   4286  4fe6		       2a		      rol
   4287  4fe7		       29 03		      and	#bs_mask	;1 3 or 7 for F8/F6/F4
   4288  4fe9		       aa		      tax
   4289  4fea		       e8		      inx
   4290  4feb				  -	      else
   4291  4feb				  -	      lda	4,x	; get high byte of return address
   4292  4feb				  -	      tay
   4293  4feb				  -	      ora	#$10	; change our bank nibble into a valid rom mirror
   4294  4feb				  -	      sta	4,x
   4295  4feb				  -	      tya
   4296  4feb				  -	      lsr
   4297  4feb				  -	      lsr
   4298  4feb				  -	      lsr
   4299  4feb				  -	      lsr
   4300  4feb				  -	      tax
   4301  4feb				  -	      inx
   4302  4feb					      endif
   4303  4feb
   4304  4feb				   BS_jsr
   4305  4feb		       bd f5 1f 	      lda	bankswitch_hotspot-1,x
   4306  4fee		       68		      pla
   4307  4fef		       aa		      tax
   4308  4ff0		       68		      pla
   4309  4ff1		       60		      rts
   4310  4ff2				  -	      if	((* & $1FFF) > ((bankswitch_hotspot & $1FFF) - 1))
   4311  4ff2				  -	      echo	"WARNING: size parameter in banksw.asm too small - the program probably will not work."
   4312  4ff2				  -	      echo	"Change to",[(*-begin_bscode+1)&$FF]d,"and try again."
   4313  4ff2					      endif
   4314  4ff2							; Provided under the CC0 license. See the included LICENSE.txt for details.
   4315  4ff2
   4316  4ff2					      ifconst	bankswitch
   4317  4ff2				  -	      if	bankswitch == 8
   4318  4ff2				  -	      ORG	$2FFC
   4319  4ff2				  -	      RORG	$FFFC
   4320  4ff2					      endif
   4321  4ff2					      if	bankswitch == 16
   4322  4ffc					      ORG	$4FFC
   4323  4ffc					      RORG	$FFFC
   4324  4ffc					      endif
   4325  4ffc				  -	      if	bankswitch == 32
   4326  4ffc				  -	      ORG	$8FFC
   4327  4ffc				  -	      RORG	$FFFC
   4328  4ffc					      endif
   4329  4ffc				  -	      if	bankswitch == 64
   4330  4ffc				  -	      ORG	$10FF0
   4331  4ffc				  -	      RORG	$1FFF0
   4332  4ffc				  -	      lda	$ffe0	; we use wasted space to assist stella with EF format auto-detection
   4333  4ffc				  -	      ORG	$10FF8
   4334  4ffc				  -	      RORG	$1FFF8
   4335  4ffc				  -	      ifconst	superchip
   4336  4ffc				  -	      .byte	"E","F","S","C"
   4337  4ffc				  -	      else
   4338  4ffc				  -	      .byte	"E","F","E","F"
   4339  4ffc				  -	      endif
   4340  4ffc				  -	      ORG	$10FFC
   4341  4ffc				  -	      RORG	$1FFFC
   4342  4ffc					      endif
   4343  4ffc				  -	      else
   4344  4ffc				  -	      ifconst	ROM2k
   4345  4ffc				  -	      ORG	$F7FC
   4346  4ffc				  -	      else
   4347  4ffc				  -	      ORG	$FFFC
   4348  4ffc				  -	      endif
   4349  4ffc					      endif
   4350  4ffc		       d5 f3		      .word.w	(start & $ffff)
   4351  4ffe		       d5 f3		      .word.w	(start & $ffff)
