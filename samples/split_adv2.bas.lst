      3796 bytes of ROM space left in bank 3
   2410  3100					      echo	"    ",[(start_bank3 - *)]d , "bytes of ROM space left in bank 3")
   2411  3100					      endif
   2412  3100		       00 01	   ECHO3      =	1
   2413  3fd4					      ORG	$3FF4-bscode_length
   2414  3fd4					      RORG	$DFF4-bscode_length
   2415  3fd4		       a2 ff	   start_bank3 ldx	#$ff
   2416  3fd6				  -	      ifconst	FASTFETCH	; using DPC+
   2417  3fd6				  -	      stx	FASTFETCH
   2418  3fd6					      endif
   2419  3fd6		       9a		      txs
   2420  3fd7				  -	      if	bankswitch == 64
   2421  3fd7				  -	      lda	#(((>(start-1)) & $0F) | $F0)
