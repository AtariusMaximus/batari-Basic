   2423  3fd7		       a9 f3		      lda	#>(start-1)
   2424  3fd9					      endif
   2425  3fd9		       48		      pha
   2426  3fda		       a9 e0		      lda	#<(start-1)
   2427  3fdc		       48		      pha
   2428  3fdd		       48		      pha
   2429  3fde		       8a		      txa
   2430  3fdf		       48		      pha
   2431  3fe0		       ba		      tsx
