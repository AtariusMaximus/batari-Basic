   2434  3fe3		       2a		      rol
   2435  3fe4		       2a		      rol
   2436  3fe5		       2a		      rol
   2437  3fe6		       2a		      rol
   2438  3fe7		       29 03		      and	#bs_mask	;1 3 or 7 for F8/F6/F4
   2439  3fe9		       aa		      tax
   2440  3fea		       e8		      inx
   2441  3feb				  -	      else
   2442  3feb				  -	      lda	4,x	; get high byte of return address
   2443  3feb				  -	      tay
   2444  3feb				  -	      ora	#$10	; change our bank nibble into a valid rom mirror
   2445  3feb				  -	      sta	4,x
   2446  3feb				  -	      tya
   2447  3feb				  -	      lsr
   2448  3feb				  -	      lsr
   2449  3feb				  -	      lsr
   2450  3feb				  -	      lsr
   2451  3feb				  -	      tax
   2452  3feb				  -	      inx
   2453  3feb					      endif
