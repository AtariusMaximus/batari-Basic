   4469  4feb		       bd f5 1f 	      lda	bankswitch_hotspot-1,x
   4470  4fee		       68		      pla
   4471  4fef		       aa		      tax
   4472  4ff0		       68		      pla
   4473  4ff1		       60		      rts
