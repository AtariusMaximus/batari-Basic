   4414  4fd4
   4415  4fd4							; every bank has this stuff at the same place
   4416  4fd4							; this code can switch to/from any bank at any entry point
   4417  4fd4							; and can preserve register values
   4418  4fd4							; note: lines not starting with a space are not placed in all banks
   4419  4fd4							;
   4420  4fd4							; line below tells the compiler how long this is - do not remove
   4421  4fd4							;size=32
   4422  4fd4
   4423  4fd4				   begin_bscode
   4424  4fd4		       a2 ff		      ldx	#$ff
   4425  4fd6				  -	      ifconst	FASTFETCH	; using DPC+
   4426  4fd6				  -	      stx	FASTFETCH
   4427  4fd6					      endif
   4428  4fd6		       9a		      txs
   4429  4fd7				  -	      if	bankswitch == 64
   4430  4fd7				  -	      lda	#(((>(start-1)) & $0F) | $F0)
   4431  4fd7					      else
   4432  4fd7		       a9 f3		      lda	#>(start-1)
   4433  4fd9					      endif
   4434  4fd9		       48		      pha
   4435  4fda		       a9 e0		      lda	#<(start-1)
   4436  4fdc		       48		      pha
   4437  4fdd
   4438  4fdd				   BS_return
   4439  4fdd		       48		      pha
   4440  4fde		       8a		      txa
   4441  4fdf		       48		      pha
   4442  4fe0		       ba		      tsx
   4443  4fe1
   4444  4fe1					      if	bankswitch != 64
   4445  4fe1		       b5 04		      lda	4,x	; get high byte of return address
   4446  4fe3
   4447  4fe3		       2a		      rol
   4448  4fe4		       2a		      rol
   4449  4fe5		       2a		      rol
   4450  4fe6		       2a		      rol
   4451  4fe7		       29 03		      and	#bs_mask	;1 3 or 7 for F8/F6/F4
   4452  4fe9		       aa		      tax
   4453  4fea		       e8		      inx
   4454  4feb				  -	      else
   4455  4feb				  -	      lda	4,x	; get high byte of return address
   4456  4feb				  -	      tay
   4457  4feb				  -	      ora	#$10	; change our bank nibble into a valid rom mirror
   4458  4feb				  -	      sta	4,x
   4459  4feb				  -	      tya
   4460  4feb				  -	      lsr
   4461  4feb				  -	      lsr
   4462  4feb				  -	      lsr
