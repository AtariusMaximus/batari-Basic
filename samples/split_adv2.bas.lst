     26  5000 ????	       00 dd	   p2_player1y =	j
     27  5000 ????
     28  5000 ????	       00 dc	   p1_oldy    =	i
     29  5000 ????
     30  5000 ????	       00 db	   p1_oldx    =	h
     31  5000 ????
     32  5000 ????	       00 da	   p0_oldy    =	g
     33  5000 ????
     34  5000 ????	       00 d9	   p0_oldx    =	f
