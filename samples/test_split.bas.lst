   2806  3fe9		       aa		      tax
   2807  3fea		       e8		      inx
   2808  3feb				  -	      else
   2809  3feb				  -	      lda	4,x	; get high byte of return address
   2810  3feb				  -	      tay
   2811  3feb				  -	      ora	#$10	; change our bank nibble into a valid rom mirror
   2812  3feb				  -	      sta	4,x
