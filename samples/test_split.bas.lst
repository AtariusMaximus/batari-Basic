   2714  2100					      echo	"    ",[(start_bank2 - *)]d , "bytes of ROM space left in bank 2")
   2715  2100					      endif
   2716  2100		       00 01	   ECHO2      =	1
   2717  2fd4					      ORG	$2FF4-bscode_length
   2718  2fd4					      RORG	$BFF4-bscode_length
   2719  2fd4		       a2 ff	   start_bank2 ldx	#$ff
