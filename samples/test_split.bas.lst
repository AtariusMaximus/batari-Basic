   4874  4fdd		       48		      pha
   4875  4fde		       8a		      txa
   4876  4fdf		       48		      pha
   4877  4fe0		       ba		      tsx
   4878  4fe1
   4879  4fe1					      if	bankswitch != 64
   4880  4fe1		       b5 04		      lda	4,x	; get high byte of return address
   4881  4fe3
   4882  4fe3		       2a		      rol
   4883  4fe4		       2a		      rol
   4884  4fe5		       2a		      rol
   4885  4fe6		       2a		      rol
   4886  4fe7		       29 03		      and	#bs_mask	;1 3 or 7 for F8/F6/F4
   4887  4fe9		       aa		      tax
   4888  4fea		       e8		      inx
   4889  4feb				  -	      else
   4890  4feb				  -	      lda	4,x	; get high byte of return address
   4891  4feb				  -	      tay
   4892  4feb				  -	      ora	#$10	; change our bank nibble into a valid rom mirror
   4893  4feb				  -	      sta	4,x
