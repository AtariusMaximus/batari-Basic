   2777  3100					      echo	"    ",[(start_bank3 - *)]d , "bytes of ROM space left in bank 3")
   2778  3100					      endif
   2779  3100		       00 01	   ECHO3      =	1
   2780  3fd4					      ORG	$3FF4-bscode_length
   2781  3fd4					      RORG	$DFF4-bscode_length
   2782  3fd4		       a2 ff	   start_bank3 ldx	#$ff
   2783  3fd6				  -	      ifconst	FASTFETCH	; using DPC+
   2784  3fd6				  -	      stx	FASTFETCH
   2785  3fd6					      endif
   2786  3fd6		       9a		      txs
   2787  3fd7				  -	      if	bankswitch == 64
   2788  3fd7				  -	      lda	#(((>(start-1)) & $0F) | $F0)
   2789  3fd7					      else
   2790  3fd7		       a9 f3		      lda	#>(start-1)
   2791  3fd9					      endif
   2792  3fd9		       48		      pha
   2793  3fda		       a9 f4		      lda	#<(start-1)
   2794  3fdc		       48		      pha
