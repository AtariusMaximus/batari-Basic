   2764  2ff2				  -	      echo	"WARNING: size parameter in banksw.asm too small - the program probably will not work."
   2765  2ff2				  -	      echo	"Change to",[(*-begin_bscode+1)&$FF]d,"and try again."
   2766  2ff2					      endif
