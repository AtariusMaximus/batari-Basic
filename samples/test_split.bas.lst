   4850  4fd4							; every bank has this stuff at the same place
   4851  4fd4							; this code can switch to/from any bank at any entry point
   4852  4fd4							; and can preserve register values
   4853  4fd4							; note: lines not starting with a space are not placed in all banks
   4854  4fd4							;
   4855  4fd4							; line below tells the compiler how long this is - do not remove
   4856  4fd4							;size=32
   4857  4fd4
   4858  4fd4				   begin_bscode
   4859  4fd4		       a2 ff		      ldx	#$ff
   4860  4fd6				  -	      ifconst	FASTFETCH	; using DPC+
   4861  4fd6				  -	      stx	FASTFETCH
   4862  4fd6					      endif
   4863  4fd6		       9a		      txs
   4864  4fd7				  -	      if	bankswitch == 64
   4865  4fd7				  -	      lda	#(((>(start-1)) & $0F) | $F0)
   4866  4fd7					      else
   4867  4fd7		       a9 f3		      lda	#>(start-1)
   4868  4fd9					      endif
   4869  4fd9		       48		      pha
   4870  4fda		       a9 f4		      lda	#<(start-1)
   4871  4fdc		       48		      pha
   4872  4fdd
