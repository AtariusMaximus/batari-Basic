   2721  2fd6				  -	      stx	FASTFETCH
   2722  2fd6					      endif
   2723  2fd6		       9a		      txs
   2724  2fd7				  -	      if	bankswitch == 64
   2725  2fd7				  -	      lda	#(((>(start-1)) & $0F) | $F0)
