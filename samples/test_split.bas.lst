   2727  2fd7		       a9 f3		      lda	#>(start-1)
   2728  2fd9					      endif
   2729  2fd9		       48		      pha
   2730  2fda		       a9 f4		      lda	#<(start-1)
   2731  2fdc		       48		      pha
   2732  2fdd		       48		      pha
   2733  2fde		       8a		      txa
   2734  2fdf		       48		      pha
   2735  2fe0		       ba		      tsx
   2736  2fe1					      if	bankswitch != 64
   2737  2fe1		       b5 04		      lda	4,x	; get high byte of return address
   2738  2fe3		       2a		      rol
   2739  2fe4		       2a		      rol
   2740  2fe5		       2a		      rol
   2741  2fe6		       2a		      rol
   2742  2fe7		       29 03		      and	#bs_mask	;1 3 or 7 for F8/F6/F4
   2743  2fe9		       aa		      tax
   2744  2fea		       e8		      inx
   2745  2feb				  -	      else
   2746  2feb				  -	      lda	4,x	; get high byte of return address
   2747  2feb				  -	      tay
   2748  2feb				  -	      ora	#$10	; change our bank nibble into a valid rom mirror
   2749  2feb				  -	      sta	4,x
   2750  2feb				  -	      tya
   2751  2feb				  -	      lsr
   2752  2feb				  -	      lsr
   2753  2feb				  -	      lsr
   2754  2feb				  -	      lsr
   2755  2feb				  -	      tax
   2756  2feb				  -	      inx
   2757  2feb					      endif
   2758  2feb		       bd f5 1f 	      lda	bankswitch_hotspot-1,x
   2759  2fee		       68		      pla
   2760  2fef		       aa		      tax
   2761  2ff0		       68		      pla
   2762  2ff1		       60		      rts
