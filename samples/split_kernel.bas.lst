     13  5000 ????
     14  5000 ????	       00 d8	   p2_player0pointerlo =	e
     15  5000 ????
     16  5000 ????	       00 d7	   p2_player1x =	d
     17  5000 ????
     18  5000 ????	       00 d6	   p2_player0x =	c
     19  5000 ????
     20  5000 ????	       00 d5	   p2_player1y =	b
     21  5000 ????
     22  5000 ????	       00 d4	   p2_player0y =	a
     23  5000 ????
     24  5000 ????	       00 01	   superchip  =	1
     25  5000 ????	       00 03	   bs_mask    =	3
     26  5000 ????	       00 10	   bankswitch =	16
     27  5000 ????	       1f f6	   bankswitch_hotspot =	$1FF6
     28  5000 ????	       00 01	   split_kernel =	1
