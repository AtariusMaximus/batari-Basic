     13  5000 ????
     14  5000 ????	       00 d9	   p2_player0pointerhi =	f
     15  5000 ????
     16  5000 ????	       00 d8	   p2_player0pointerlo =	e
     17  5000 ????
     18  5000 ????	       00 d7	   p2_player1x =	d
     19  5000 ????
     20  5000 ????	       00 d6	   p2_player0x =	c
     21  5000 ????
     22  5000 ????	       00 d5	   p2_player1y =	b
     23  5000 ????
     24  5000 ????	       00 d4	   p2_player0y =	a
     25  5000 ????
     26  5000 ????	       00 01	   superchip  =	1
     27  5000 ????	       00 03	   bs_mask    =	3
