   2575  4fd6					      endif
   2576  4fd6		       9a		      txs
   2577  4fd7				  -	      if	bankswitch == 64
   2578  4fd7				  -	      lda	#(((>(start-1)) & $0F) | $F0)
   2579  4fd7					      else
