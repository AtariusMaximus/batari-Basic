    540  2100					      if	ECHO2
      3796 bytes of ROM space left in bank 2
    541  2100					      echo	"    ",[(start_bank2 - *)]d , "bytes of ROM space left in bank 2")
    542  2100					      endif
    543  2100		       00 01	   ECHO2      =	1
    544  2fd4					      ORG	$2FF4-bscode_length
    545  2fd4					      RORG	$BFF4-bscode_length
    546  2fd4		       a2 ff	   start_bank2 ldx	#$ff
    547  2fd6				  -	      ifconst	FASTFETCH	; using DPC+
    548  2fd6				  -	      stx	FASTFETCH
    549  2fd6					      endif
    550  2fd6		       9a		      txs
    551  2fd7				  -	      if	bankswitch == 64
    552  2fd7				  -	      lda	#(((>(start-1)) & $0F) | $F0)
    553  2fd7					      else
    554  2fd7		       a9 f3		      lda	#>(start-1)
    555  2fd9					      endif
    556  2fd9		       48		      pha
    557  2fda		       a9 cc		      lda	#<(start-1)
    558  2fdc		       48		      pha
    559  2fdd		       48		      pha
    560  2fde		       8a		      txa
    561  2fdf		       48		      pha
    562  2fe0		       ba		      tsx
    563  2fe1					      if	bankswitch != 64
    564  2fe1		       b5 04		      lda	4,x	; get high byte of return address
    565  2fe3		       2a		      rol
    566  2fe4		       2a		      rol
    567  2fe5		       2a		      rol
    568  2fe6		       2a		      rol
    569  2fe7		       29 03		      and	#bs_mask	;1 3 or 7 for F8/F6/F4
    570  2fe9		       aa		      tax
    571  2fea		       e8		      inx
    572  2feb				  -	      else
    573  2feb				  -	      lda	4,x	; get high byte of return address
    574  2feb				  -	      tay
    575  2feb				  -	      ora	#$10	; change our bank nibble into a valid rom mirror
    576  2feb				  -	      sta	4,x
    577  2feb				  -	      tya
    578  2feb				  -	      lsr
    579  2feb				  -	      lsr
    580  2feb				  -	      lsr
    581  2feb				  -	      lsr
    582  2feb				  -	      tax
    583  2feb				  -	      inx
    584  2feb					      endif
    585  2feb		       bd f5 1f 	      lda	bankswitch_hotspot-1,x
    586  2fee		       68		      pla
    587  2fef		       aa		      tax
    588  2ff0		       68		      pla
    589  2ff1		       60		      rts
    590  2ff2				  -	      if	((* & $1FFF) > ((bankswitch_hotspot & $1FFF) - 1))
    591  2ff2				  -	      echo	"WARNING: size parameter in banksw.asm too small - the program probably will not work."
    592  2ff2				  -	      echo	"Change to",[(*-begin_bscode+1)&$FF]d,"and try again."
    593  2ff2					      endif
