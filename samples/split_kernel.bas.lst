      3796 bytes of ROM space left in bank 3
    622  3100					      echo	"    ",[(start_bank3 - *)]d , "bytes of ROM space left in bank 3")
    623  3100					      endif
    624  3100		       00 01	   ECHO3      =	1
    625  3fd4					      ORG	$3FF4-bscode_length
    626  3fd4					      RORG	$DFF4-bscode_length
