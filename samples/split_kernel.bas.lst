    635  3fd7		       a9 f3		      lda	#>(start-1)
    636  3fd9					      endif
    637  3fd9		       48		      pha
    638  3fda		       a9 cc		      lda	#<(start-1)
    639  3fdc		       48		      pha
    640  3fdd		       48		      pha
    641  3fde		       8a		      txa
    642  3fdf		       48		      pha
