    646  3fe3		       2a		      rol
    647  3fe4		       2a		      rol
    648  3fe5		       2a		      rol
    649  3fe6		       2a		      rol
    650  3fe7		       29 03		      and	#bs_mask	;1 3 or 7 for F8/F6/F4
    651  3fe9		       aa		      tax
    652  3fea		       e8		      inx
    653  3feb				  -	      else
    654  3feb				  -	      lda	4,x	; get high byte of return address
    655  3feb				  -	      tay
    656  3feb				  -	      ora	#$10	; change our bank nibble into a valid rom mirror
    657  3feb				  -	      sta	4,x
    658  3feb				  -	      tya
    659  3feb				  -	      lsr
    660  3feb				  -	      lsr
    661  3feb				  -	      lsr
    662  3feb				  -	      lsr
    663  3feb				  -	      tax
    664  3feb				  -	      inx
