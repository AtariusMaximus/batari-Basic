    603  3100					      if	ECHO3
      3796 bytes of ROM space left in bank 3
    604  3100					      echo	"    ",[(start_bank3 - *)]d , "bytes of ROM space left in bank 3")
    605  3100					      endif
    606  3100		       00 01	   ECHO3      =	1
    607  3fd4					      ORG	$3FF4-bscode_length
    608  3fd4					      RORG	$DFF4-bscode_length
    609  3fd4		       a2 ff	   start_bank3 ldx	#$ff
    610  3fd6				  -	      ifconst	FASTFETCH	; using DPC+
    611  3fd6				  -	      stx	FASTFETCH
    612  3fd6					      endif
    613  3fd6		       9a		      txs
    614  3fd7				  -	      if	bankswitch == 64
    615  3fd7				  -	      lda	#(((>(start-1)) & $0F) | $F0)
    616  3fd7					      else
    617  3fd7		       a9 f3		      lda	#>(start-1)
    618  3fd9					      endif
    619  3fd9		       48		      pha
    620  3fda		       a9 cc		      lda	#<(start-1)
    621  3fdc		       48		      pha
    622  3fdd		       48		      pha
    623  3fde		       8a		      txa
    624  3fdf		       48		      pha
    625  3fe0		       ba		      tsx
    626  3fe1					      if	bankswitch != 64
    627  3fe1		       b5 04		      lda	4,x	; get high byte of return address
    628  3fe3		       2a		      rol
    629  3fe4		       2a		      rol
    630  3fe5		       2a		      rol
    631  3fe6		       2a		      rol
    632  3fe7		       29 03		      and	#bs_mask	;1 3 or 7 for F8/F6/F4
    633  3fe9		       aa		      tax
    634  3fea		       e8		      inx
    635  3feb				  -	      else
    636  3feb				  -	      lda	4,x	; get high byte of return address
    637  3feb				  -	      tay
    638  3feb				  -	      ora	#$10	; change our bank nibble into a valid rom mirror
    639  3feb				  -	      sta	4,x
    640  3feb				  -	      tya
    641  3feb				  -	      lsr
    642  3feb				  -	      lsr
    643  3feb				  -	      lsr
    644  3feb				  -	      lsr
    645  3feb				  -	      tax
    646  3feb				  -	      inx
    647  3feb					      endif
    648  3feb		       bd f5 1f 	      lda	bankswitch_hotspot-1,x
    649  3fee		       68		      pla
    650  3fef		       aa		      tax
    651  3ff0		       68		      pla
    652  3ff1		       60		      rts
    653  3ff2				  -	      if	((* & $1FFF) > ((bankswitch_hotspot & $1FFF) - 1))
    654  3ff2				  -	      echo	"WARNING: size parameter in banksw.asm too small - the program probably will not work."
    655  3ff2				  -	      echo	"Change to",[(*-begin_bscode+1)&$FF]d,"and try again."
    656  3ff2					      endif
    657  3ffc					      ORG	$3FFC
    658  3ffc					      RORG	$DFFC
    659  3ffc		       d4 df		      .word.w	(start_bank3 & $ffff)
    660  3ffe		       d4 df		      .word.w	(start_bank3 & $ffff)
    661  4000					      ORG	$4000
    662  4000					      RORG	$F000
    663  4000					      repeat	256
