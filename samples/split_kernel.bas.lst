    558  2100					      if	ECHO2
      3796 bytes of ROM space left in bank 2
    559  2100					      echo	"    ",[(start_bank2 - *)]d , "bytes of ROM space left in bank 2")
    560  2100					      endif
    561  2100		       00 01	   ECHO2      =	1
    562  2fd4					      ORG	$2FF4-bscode_length
    563  2fd4					      RORG	$BFF4-bscode_length
    564  2fd4		       a2 ff	   start_bank2 ldx	#$ff
    565  2fd6				  -	      ifconst	FASTFETCH	; using DPC+
    566  2fd6				  -	      stx	FASTFETCH
    567  2fd6					      endif
    568  2fd6		       9a		      txs
    569  2fd7				  -	      if	bankswitch == 64
    570  2fd7				  -	      lda	#(((>(start-1)) & $0F) | $F0)
    571  2fd7					      else
    572  2fd7		       a9 f3		      lda	#>(start-1)
    573  2fd9					      endif
    574  2fd9		       48		      pha
    575  2fda		       a9 cc		      lda	#<(start-1)
    576  2fdc		       48		      pha
    577  2fdd		       48		      pha
    578  2fde		       8a		      txa
    579  2fdf		       48		      pha
    580  2fe0		       ba		      tsx
    581  2fe1					      if	bankswitch != 64
    582  2fe1		       b5 04		      lda	4,x	; get high byte of return address
    583  2fe3		       2a		      rol
    584  2fe4		       2a		      rol
    585  2fe5		       2a		      rol
    586  2fe6		       2a		      rol
    587  2fe7		       29 03		      and	#bs_mask	;1 3 or 7 for F8/F6/F4
    588  2fe9		       aa		      tax
    589  2fea		       e8		      inx
    590  2feb				  -	      else
    591  2feb				  -	      lda	4,x	; get high byte of return address
    592  2feb				  -	      tay
    593  2feb				  -	      ora	#$10	; change our bank nibble into a valid rom mirror
    594  2feb				  -	      sta	4,x
    595  2feb				  -	      tya
    596  2feb				  -	      lsr
    597  2feb				  -	      lsr
    598  2feb				  -	      lsr
    599  2feb				  -	      lsr
    600  2feb				  -	      tax
    601  2feb				  -	      inx
    602  2feb					      endif
    603  2feb		       bd f5 1f 	      lda	bankswitch_hotspot-1,x
    604  2fee		       68		      pla
    605  2fef		       aa		      tax
    606  2ff0		       68		      pla
    607  2ff1		       60		      rts
    608  2ff2				  -	      if	((* & $1FFF) > ((bankswitch_hotspot & $1FFF) - 1))
    609  2ff2				  -	      echo	"WARNING: size parameter in banksw.asm too small - the program probably will not work."
    610  2ff2				  -	      echo	"Change to",[(*-begin_bscode+1)&$FF]d,"and try again."
    611  2ff2					      endif
    612  2ffc					      ORG	$2FFC
    613  2ffc					      RORG	$BFFC
    614  2ffc		       d4 bf		      .word.w	(start_bank2 & $ffff)
    615  2ffe		       d4 bf		      .word.w	(start_bank2 & $ffff)
