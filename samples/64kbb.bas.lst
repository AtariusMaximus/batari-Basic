------- FILE macro.h LEVEL 2 PASS 2
      0  11000 ????				       include	"macro.h"
      1  11000 ????						; Provided under the CC0 license. See the included LICENSE.txt for details.
      2  11000 ????
      3  11000 ????						; MACRO.H
      4  11000 ????						; Version 1.05, 13/NOVEMBER/2003
      5  11000 ????
      6  11000 ????		00 69	    VERSION_MACRO =	105
      7  11000 ????
      8  11000 ????						;
      9  11000 ????						; THIS FILE IS EXPLICITLY SUPPORTED AS A DASM-PREFERRED COMPANION FILE
     10  11000 ????						; PLEASE DO *NOT* REDISTRIBUTE MODIFIED VERSIONS OF THIS FILE!
     11  11000 ????						;
     12  11000 ????						; This file defines DASM macros useful for development for the Atari 2600.
     13  11000 ????						; It is distributed as a companion machine-specific support package
     14  11000 ????						; for the DASM compiler. Updates to this file, DASM, and associated tools are
     15  11000 ????						; available at at http://www.atari2600.org/dasm
     16  11000 ????						;
     17  11000 ????						; Many thanks to the people who have contributed.  If you take issue with the
     18  11000 ????						; contents, or would like to add something, please write to me
     19  11000 ????						; (atari2600@taswegian.com) with your contribution.
     20  11000 ????						;
     21  11000 ????						; Latest Revisions...
     22  11000 ????						;
     23  11000 ????						; 1.05  14/NOV/2003	  - Added VERSION_MACRO equate (which will reflect 100x version #)
     24  11000 ????						;			    This will allow conditional code to verify MACRO.H being
     25  11000 ????						;			    used for code assembly.
     26  11000 ????						; 1.04  13/NOV/2003	 - SET_POINTER macro added (16-bit address load)
     27  11000 ????						;
     28  11000 ????						; 1.03  23/JUN/2003	 - CLEAN_START macro added - clears TIA, RAM, registers
     29  11000 ????						;
     30  11000 ????						; 1.02  14/JUN/2003	 - VERTICAL_SYNC macro added
     31  11000 ????						;			   (standardised macro for vertical synch code)
     32  11000 ????						; 1.01  22/MAR/2003	 - SLEEP macro added. 
     33  11000 ????						;			 - NO_ILLEGAL_OPCODES switch implemented
     34  11000 ????						; 1.0	22/MAR/2003		Initial release
     35  11000 ????
     36  11000 ????						; Note: These macros use illegal opcodes.  To disable illegal opcode usage, 
     37  11000 ????						;   define the symbol NO_ILLEGAL_OPCODES (-DNO_ILLEGAL_OPCODES=1 on command-line).
     38  11000 ????						;   If you do not allow illegal opcode usage, you must include this file 
     39  11000 ????						;   *after* including VCS.H (as the non-illegal opcodes access hardware
     40  11000 ????						;   registers and require them to be defined first).
     41  11000 ????
     42  11000 ????						; Available macros...
     43  11000 ????						;   SLEEP n		 - sleep for n cycles
     44  11000 ????						;   VERTICAL_SYNC	 - correct 3 scanline vertical synch code
     45  11000 ????						;   CLEAN_START	 - set machine to known state on startup
     46  11000 ????						;   SET_POINTER	 - load a 16-bit absolute to a 16-bit variable
     47  11000 ????
     48  11000 ????						;-------------------------------------------------------------------------------
     49  11000 ????						; SLEEP duration
     50  11000 ????						; Original author: Thomas Jentzsch
     51  11000 ????						; Inserts code which takes the specified number of cycles to execute.	This is
     52  11000 ????						; useful for code where precise timing is required.
     53  11000 ????						; ILLEGAL-OPCODE VERSION DOES NOT AFFECT FLAGS OR REGISTERS.
     54  11000 ????						; LEGAL OPCODE VERSION MAY AFFECT FLAGS
     55  11000 ????						; Uses illegal opcode (DASM 2.20.01 onwards).
     56  11000 ????
     57  11000 ????				       MAC	sleep
     58  11000 ????			    .CYCLES    SET	{1}
     59  11000 ????
     60  11000 ????				       IF	.CYCLES < 2
     61  11000 ????				       ECHO	"MACRO ERROR: 'SLEEP': Duration must be > 1"
     62  11000 ????				       ERR
     63  11000 ????				       ENDIF
     64  11000 ????
     65  11000 ????				       IF	.CYCLES & 1
     66  11000 ????				       IFNCONST	NO_ILLEGAL_OPCODES
     67  11000 ????				       nop	0
     68  11000 ????				       ELSE
     69  11000 ????				       bit	VSYNC
     70  11000 ????				       ENDIF
     71  11000 ????			    .CYCLES    SET	.CYCLES - 3
     72  11000 ????				       ENDIF
     73  11000 ????
     74  11000 ????				       REPEAT	.CYCLES / 2
     75  11000 ????				       nop
     76  11000 ????				       REPEND
     77  11000 ????				       ENDM		;usage: SLEEP n (n>1)
     78  11000 ????
     79  11000 ????						;-------------------------------------------------------------------------------
     80  11000 ????						; VERTICAL_SYNC
     81  11000 ????						; Original author: Manuel Polik
     82  11000 ????						; Inserts the code required for a proper 3 scannline 
     83  11000 ????						; vertical sync sequence
     84  11000 ????						;
     85  11000 ????						; Note: Alters the accumulator
     86  11000 ????						;
     87  11000 ????						; IN:
     88  11000 ????						; OUT: A = 1
     89  11000 ????
     90  11000 ????				       MAC	vertical_sync
     91  11000 ????				       LDA	#$02	; A = VSYNC enable
     92  11000 ????				       STA	WSYNC	; Finish current line
     93  11000 ????				       STA	VSYNC	; Start vertical sync
     94  11000 ????				       STA	WSYNC	; 1st line vertical sync
     95  11000 ????				       STA	WSYNC	; 2nd line vertical sync
     96  11000 ????				       LSR		; A = VSYNC disable
     97  11000 ????				       STA	WSYNC	; 3rd line vertical sync
     98  11000 ????				       STA	VSYNC	; Stop vertical sync
     99  11000 ????				       ENDM
    100  11000 ????
    101  11000 ????						;-------------------------------------------------------------------------------
    102  11000 ????						; CLEAN_START
    103  11000 ????						; Original author: Andrew Davie
    104  11000 ????						; Standardised start-up code, clears stack, all TIA registers and RAM to 0
    105  11000 ????						; Sets stack pointer to $FF, and all registers to 0
    106  11000 ????						; Sets decimal mode off, sets interrupt flag (kind of un-necessary)
    107  11000 ????						; Use as very first section of code on boot (ie: at reset)
    108  11000 ????						; Code written to minimise total ROM usage - uses weird 6502 knowledge :)
    109  11000 ????
    110  11000 ????				       MAC	clean_start
    111  11000 ????				       sei
    112  11000 ????				       cld
    113  11000 ????
    114  11000 ????				       ldx	#0
    115  11000 ????				       txa
    116  11000 ????				       tay
    117  11000 ????			    .CLEAR_STACK dex
    118  11000 ????				       txs
    119  11000 ????				       pha
    120  11000 ????				       bne	.CLEAR_STACK	; SP=$FF, X = A = Y = 0
    121  11000 ????
    122  11000 ????				       ENDM
    123  11000 ????
    124  11000 ????						;-------------------------------------------------------
    125  11000 ????						; SET_POINTER
    126  11000 ????						; Original author: Manuel Rotschkar
    127  11000 ????						;
    128  11000 ????						; Sets a 2 byte RAM pointer to an absolute address.
    129  11000 ????						;
    130  11000 ????						; Usage: SET_POINTER pointer, address
    131  11000 ????						; Example: SET_POINTER SpritePTR, SpriteData
    132  11000 ????						;
    133  11000 ????						; Note: Alters the accumulator, NZ flags
    134  11000 ????						; IN 1: 2 byte RAM location reserved for pointer
    135  11000 ????						; IN 2: absolute address
    136  11000 ????
    137  11000 ????				       MAC	set_pointer
    138  11000 ????			    .POINTER   SET	{1}
    139  11000 ????			    .ADDRESS   SET	{2}
    140  11000 ????
    141  11000 ????				       LDA	#<.ADDRESS	; Get Lowbyte of Address
    142  11000 ????				       STA	.POINTER	; Store in pointer
    143  11000 ????				       LDA	#>.ADDRESS	; Get Hibyte of Address
    144  11000 ????				       STA	.POINTER+1	; Store in pointer+1
    145  11000 ????
    146  11000 ????				       ENDM
    147  11000 ????
    148  11000 ????						; EOF
