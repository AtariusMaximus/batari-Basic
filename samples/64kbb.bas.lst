   3625  10fbe				   -	       ifconst	FASTFETCH	; using DPC+
   3626  10fbe				   -	       stx	FASTFETCH
   3627  10fbe					       endif
   3628  10fbe			9a		       txs
   3629  10fbf					       if	bankswitch == 64
   3630  10fbf			a9 f2		       lda	#(((>(start-1)) & $0F) | $F0)
   3631  10fc1				   -	       else
   3632  10fc1				   -	       lda	#>(start-1)
   3633  10fc1					       endif
   3634  10fc1			48		       pha
